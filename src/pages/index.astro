---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteNav from "../components/SiteNav.astro";
import AgeGate from "../components/AgeGate.astro";
import JobPopup from "../components/JobPopup.astro";
---

<BaseLayout
  title="BoyKingTut.com — Financial Domination Quantum"
  description="Crypto systems, local advertising, affiliate opportunities, Reddit articles, TikTok updates, Second Life metaverse access and Egypt travel information."
>
  <AgeGate />
  <JobPopup />

  <div id="top" class="site">
    <SiteNav />

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-orbit hero-orbit-a" aria-hidden="true"></div>
        <div class="hero-orbit hero-orbit-b" aria-hidden="true"></div>

        <div class="hero-copy-wrap">
          <p class="kicker">BOYKINGTUT.COM</p>
          <h1 id="hero-title">
            Financial Domination
            <span>Quantum</span>
          </h1>
          <p class="hero-copy">
            A premium gateway for crypto systems, local business advertising, independent affiliate opportunities,
            Reddit articles, TikTok updates, Second Life metaverse access and educational Egypt travel information.
          </p>

          <div class="hero-actions">
            <a class="button button-gold" href="#services">Explore the System</a>
            <a class="button button-dark" href="#account">Join / Login</a>
          </div>

          <div class="trust-strip" aria-label="Key platform features">
            <span>18+ only</span>
            <span>Solana payments</span>
            <span>Blockchain verification</span>
            <span>Desktop + mobile</span>
          </div>
        </div>

        <aside class="hero-console" aria-label="Platform overview">
          <div class="console-head">
            <span class="console-dot"></span>
            <span>BOY KING TUT SYSTEM</span>
            <strong>ONLINE</strong>
          </div>

          <div class="console-grid">
            <article>
              <small>CRYPTO</small>
              <strong>BTC INCLUDED</strong>
              <span>Extra pairs +$50</span>
            </article>
            <article>
              <small>ADVERTISING</small>
              <strong>15–50 MILES</strong>
              <span>Local business focus</span>
            </article>
            <article>
              <small>AFFILIATES</small>
              <strong>$0 TO JOIN</strong>
              <span>Paid in SOL</span>
            </article>
            <article>
              <small>METAVERSE</small>
              <strong>PUBLIC ACCESS</strong>
              <span>Second Life</span>
            </article>
          </div>

          <div class="console-footer">
            <span>Powered by Astro + Cloudflare</span>
            <span class="pulse">LIVE SYSTEM</span>
          </div>
        </aside>
      </section>

      <section id="services" class="section" aria-labelledby="services-title">
        <header class="section-heading">
          <p class="kicker">MAIN SYSTEM</p>
          <h2 id="services-title">Everything in one place</h2>
          <p>
            Each area has its own customer experience while sharing one responsive account, payment and dashboard system.
          </p>
        </header>

        <div class="service-grid">
          <article id="crypto" class="service-card service-card-primary">
            <div class="service-icon" aria-hidden="true">₿</div>
            <div>
              <p class="service-label">ONLINE CRYPTO SYSTEM</p>
              <h3>Signals + Solo Leverage Alarm</h3>
              <p>
                Built for experienced leverage traders with Discord access, machine monitoring and Solana billing.
              </p>
            </div>
            <div class="service-meta">
              <span>Basic $50/mo</span>
              <span>Pro $150/mo</span>
              <span>BTC included</span>
            </div>
            <a class="card-link" href="#crypto-details">Explore Crypto <span>→</span></a>
          </article>

          <article id="advertising" class="service-card">
            <div class="service-icon" aria-hidden="true">⌖</div>
            <div>
              <p class="service-label">LOCAL ADVERTISING</p>
              <h3>Bring traffic to local businesses</h3>
              <p>
                Focused on independent pizza shops, restaurants, barbers, salons, cafés, stores and owner-operated services.
              </p>
            </div>
            <div class="service-meta">
              <span>15-mile local</span>
              <span>50-mile upgraded</span>
              <span>Progress dashboard</span>
            </div>
            <a class="card-link" href="#business-flow">View Advertising <span>→</span></a>
          </article>

          <article id="affiliate" class="service-card">
            <div class="service-icon" aria-hidden="true">♛</div>
            <div>
              <p class="service-label">AFFILIATES / MAKE MONEY</p>
              <h3>Help your community grow</h3>
              <p>
                Bring qualifying local clients, use your personal affiliate code, print brochures and monitor activity.
              </p>
            </div>
            <div class="service-meta">
              <span>$0 signup</span>
              <span>$0 monthly fee</span>
              <span>$50–$100 recurring</span>
            </div>
            <a class="card-link" href="#affiliate-flow">How to Begin <span>→</span></a>
          </article>
        </div>
      </section>

      <section id="crypto-details" class="section feature-split" aria-labelledby="solo-title">
        <div class="feature-copy">
          <p class="kicker">CRYPTO / HARDWARE</p>
          <h2 id="solo-title">Solo Leverage Alarm Machine</h2>
          <p class="lead-copy">
            A dedicated hardware alert system for experienced leverage traders. A leverage-capable exchange account and
            reliable always-on internet connection are required.
          </p>

          <div class="stat-grid">
            <div><small>Machine</small><strong>$300</strong></div>
            <div><small>Included Pair</small><strong>BTC</strong></div>
            <div><small>Extra Pair</small><strong>+$50</strong></div>
            <div><small>Maintenance</small><strong>$150–$300/mo</strong></div>
          </div>

          <div class="callout">
            <strong>Timing is critical.</strong>
            <p>
              Use cable, fiber, Starlink or reliable always-on 5G/Wi-Fi. Outages or disconnects can cause missed alerts.
              No alert guarantees profit.
            </p>
          </div>
        </div>

        <aside class="machine-panel" aria-label="Solo machine status preview">
          <div class="machine-head">
            <div>
              <span class="status-light"></span>
              <small>SOLO MACHINE</small>
            </div>
            <strong>READY</strong>
          </div>
          <div class="machine-screen">
            <div>
              <span>PAIR</span>
              <strong>BTC / USD</strong>
            </div>
            <div>
              <span>ALERT SERVICE</span>
              <strong class="green">ACTIVE</strong>
            </div>
            <div>
              <span>DISCORD</span>
              <strong class="green">CONNECTED</strong>
            </div>
            <div>
              <span>PAYMENT</span>
              <strong>SOLANA</strong>
            </div>
          </div>
          <button class="button button-gold button-full" type="button" disabled>
            Pay With Solana — Backend Next
          </button>
        </aside>
      </section>

      <section id="business-flow" class="section" aria-labelledby="business-title">
        <header class="section-heading">
          <p class="kicker">LOCAL BUSINESS WORKFLOW</p>
          <h2 id="business-title">From brochure to active campaign</h2>
          <p>
            The affiliate introduces the service. The system handles onboarding, payment verification, campaign records,
            notes and progress monitoring.
          </p>
        </header>

        <div class="timeline">
          <article><span>01</span><h3>Request business material</h3><p>Menu, brochure, service list, flyer or current price sheet.</p></article>
          <article><span>02</span><h3>Upload current image</h3><p>Confirm the business name, service details, pricing and contact information.</p></article>
          <article><span>03</span><h3>Select target area</h3><p>U.S.: ZIP + radius. International: city + country, with postal area when useful.</p></article>
          <article><span>04</span><h3>Choose a package</h3><p>Select the advertising option that fits the business and local market.</p></article>
          <article><span>05</span><h3>Pay with Solana</h3><p>Live SOL/USD quote, 5-minute lock and on-chain verification.</p></article>
          <article><span>06</span><h3>Monitor progress</h3><p>Client and affiliate dashboards show activity, notes and renewal status.</p></article>
        </div>

        <div class="legal-band">
          Campaign performance varies by location, business, competition, season, offer and customer demand.
          Specific customer-growth results are not guaranteed.
        </div>
      </section>

      <section id="affiliate-flow" class="section feature-split" aria-labelledby="affiliate-title">
        <div class="feature-copy">
          <p class="kicker">AFFILIATES / MAKE MONEY</p>
          <h2 id="affiliate-title">Start for $0</h2>
          <p class="lead-copy">
            No signup fee. No monthly affiliate platform fee. Focus on independent local businesses where the owner or
            decision-maker can approve marketing.
          </p>

          <ol class="number-list">
            <li><span>01</span><div><strong>Create your account</strong><p>Google Login will be connected in the backend phase.</p></div></li>
            <li><span>02</span><div><strong>Receive your affiliate code</strong><p>Referral URL, printable brochure and dashboard access.</p></div></li>
            <li><span>03</span><div><strong>Visit local businesses</strong><p>Pizza shops, restaurants, cafés, barbers, salons and independent shops.</p></div></li>
            <li><span>04</span><div><strong>Client signs up under you</strong><p>Help the business choose the package that fits its needs.</p></div></li>
            <li><span>05</span><div><strong>Client pays with SOL</strong><p>The client pays its own service subscription.</p></div></li>
            <li><span>06</span><div><strong>Monitor and earn</strong><p>Qualifying recurring commissions are tracked in the affiliate dashboard.</p></div></li>
          </ol>
        </div>

        <aside class="affiliate-highlight">
          <p class="kicker">AFFILIATE ACCOUNT</p>
          <h3>Your local business command center</h3>

          <div class="affiliate-kpis">
            <div><small>Signup Fee</small><strong>$0</strong></div>
            <div><small>Monthly Fee</small><strong>$0</strong></div>
            <div><small>Commission</small><strong>$50–$100</strong></div>
            <div><small>Payout</small><strong>SOL</strong></div>
          </div>

          <ul class="check-list">
            <li>Personal affiliate code</li>
            <li>Printable brochure</li>
            <li>Client monitoring</li>
            <li>Notes + progress</li>
            <li>Commission history</li>
            <li>Solana payout records</li>
          </ul>

          <a class="button button-gold button-full" href="#account">Join as Affiliate</a>
        </aside>
      </section>

      <section class="section payment-section" aria-labelledby="payment-title">
        <header class="section-heading">
          <p class="kicker">SOLANA PAYMENT ENGINE</p>
          <h2 id="payment-title">Simple, fast, verifiable</h2>
          <p>
            Prices stay in USD while checkout converts the amount to SOL. The blockchain is used to verify the actual payment.
          </p>
        </header>

        <div class="payment-flow" aria-label="Solana checkout flow">
          <div><span>1</span><strong>Choose service</strong><small>Product or subscription</small></div>
          <i>→</i>
          <div><span>2</span><strong>Live SOL rate</strong><small>CoinGecko</small></div>
          <i>→</i>
          <div><span>3</span><strong>5-minute lock</strong><small>Exact SOL amount</small></div>
          <i>→</i>
          <div><span>4</span><strong>Send SOL</strong><small>Checkout wallet</small></div>
          <i>→</i>
          <div><span>5</span><strong>Verify on-chain</strong><small>Finalized transaction</small></div>
        </div>

        <div class="legal-band">
          Blockchain verification proves a transaction occurred. It does not guarantee investment performance,
          business results or the conduct of third parties.
        </div>
      </section>

      <section class="section media-grid" aria-label="Content and community">
        <article id="reddit" class="media-card">
          <p class="kicker">REDDIT ARTICLES</p>
          <h2>400+ Articles & Memoirs</h2>
          <p>Featured writings, memoirs, observations and updates collected into one evolving archive.</p>
          <a class="card-link" href="#account">Explore Articles <span>→</span></a>
        </article>

        <article id="tiktok" class="media-card">
          <p class="kicker">TIKTOK</p>
          <h2>Updates & Live Streams</h2>
          <p>Follow <strong>@19nobodyknows22</strong> for new videos, short updates and live streams.</p>
          <a class="card-link" href="https://www.tiktok.com/@19nobodyknows22" target="_blank" rel="noopener noreferrer">
            Open TikTok <span>→</span>
          </a>
        </article>
      </section>

      <section id="metaverse" class="section metaverse-section" aria-labelledby="metaverse-title">
        <div class="metaverse-content">
          <p class="kicker">SECOND LIFE / METAVERSE</p>
          <h2 id="metaverse-title">Enter the Boy King Tut Virtual World</h2>
          <p class="lead-copy">
            A public Second Life destination where visitors can explore the environment, meet others and access the
            Boy King Tut virtual experience from desktop or supported mobile devices.
          </p>

          <div class="destination-pills">
            <span>Public Access</span>
            <span>Wild Hollow</span>
            <span>91 / 153 / 2451</span>
            <span>Desktop</span>
            <span>Mobile</span>
          </div>

          <div class="hero-actions">
            <a class="button button-gold" href="https://maps.secondlife.com/secondlife/Wild%20Hollow/91/153/2451" target="_blank" rel="noopener noreferrer">
              Teleport Now
            </a>
            <a class="button button-dark" href="https://go.secondlife.com/mobile" target="_blank" rel="noopener noreferrer">
              Mobile Access
            </a>
          </div>
        </div>

        <aside class="metaverse-display" aria-label="Second Life destination">
          <div class="portal-ring">
            <div class="portal-core">
              <span>𓂀</span>
              <strong>WILD HOLLOW</strong>
              <small>OPEN TO PUBLIC</small>
            </div>
          </div>
          <dl>
            <div><dt>Region</dt><dd>Wild Hollow</dd></div>
            <div><dt>Coordinates</dt><dd>91 / 153 / 2451</dd></div>
            <div><dt>Platform</dt><dd>Second Life</dd></div>
          </dl>
        </aside>
      </section>

      <section id="egypt" class="section egypt-section" aria-labelledby="egypt-title">
        <div>
          <p class="kicker">EGYPT — INFORMATION & EDUCATION</p>
          <h2 id="egypt-title">Explore Ancient Egypt</h2>
          <p class="lead-copy">
            Destination information covering the Grand Egyptian Museum, Giza, Abydos, Luxor, Saqqara, Dendera,
            Aswan, Abu Simbel and other important locations.
          </p>

          <div class="destination-pills">
            <span>G.E.M.</span><span>Giza</span><span>Abydos</span><span>Luxor</span>
            <span>Saqqara</span><span>Dendera</span><span>Aswan</span><span>Abu Simbel</span>
          </div>
        </div>

        <aside class="travel-notice">
          <p class="kicker">TRAVEL NOTICE</p>
          <h3>Information only</h3>
          <p>
            BoyKingTut.com is not a travel agency, tour operator, airline, hotel provider or transportation company.
          </p>
          <p>
            Travelers arrange their own flights. Any local tours, hotels, transportation, guides or excursions must be
            arranged with independent third-party providers or local travel agents.
          </p>
          <small>Prices, availability and entry requirements may change. Always verify current information directly.</small>
        </aside>
      </section>

      <section id="faq" class="section" aria-labelledby="faq-title">
        <header class="section-heading">
          <p class="kicker">FAQ</p>
          <h2 id="faq-title">Common questions</h2>
        </header>

        <div class="faq-grid">
          <details>
            <summary>How are Solana payments verified?</summary>
            <p>The production backend will verify the finalized transaction, recipient, amount and transaction uniqueness directly on-chain.</p>
          </details>
          <details>
            <summary>Why is the checkout quote only valid for 5 minutes?</summary>
            <p>SOL/USD can move quickly. The short lock keeps the required amount predictable for the active checkout.</p>
          </details>
          <details>
            <summary>Does it cost money to become an affiliate?</summary>
            <p>No signup fee and no monthly affiliate platform fee are planned. Qualifying commissions depend on eligible referred clients.</p>
          </details>
          <details>
            <summary>Can affiliates print their own brochures?</summary>
            <p>Yes. The planned dashboard includes a personal affiliate code, referral link and printable brochure.</p>
          </details>
          <details>
            <summary>Is advertising performance guaranteed?</summary>
            <p>No. Results vary by location, business, competition, season, offer and market conditions.</p>
          </details>
          <details>
            <summary>Is BoyKingTut.com a travel agency?</summary>
            <p>No. The Egypt section is informational and educational only. Travel arrangements are handled independently by travelers and third-party providers.</p>
          </details>
        </div>
      </section>

      <section id="pricing" class="section pricing-section" aria-labelledby="pricing-title">
        <header class="section-heading">
          <p class="kicker">PRICING</p>
          <h2 id="pricing-title">Current planned pricing</h2>
        </header>

        <div class="pricing-grid">
          <article><small>CRYPTO BASIC</small><strong>$50</strong><span>/month</span></article>
          <article><small>CRYPTO PRO</small><strong>$150</strong><span>/month</span></article>
          <article><small>EXTRA PAIR</small><strong>$50</strong><span>each</span></article>
          <article><small>SOLO MACHINE</small><strong>$300</strong><span>one time</span></article>
          <article><small>SOLO MAINTENANCE</small><strong>$150–$300</strong><span>/month</span></article>
          <article><small>ADVERTISING UPGRADE</small><strong>$399</strong><span>/month</span></article>
        </div>
      </section>

      <section id="account" class="section account-section" aria-labelledby="account-title">
        <div>
          <p class="kicker">ACCOUNT SYSTEM</p>
          <h2 id="account-title">One login. Different dashboards.</h2>
          <p>
            Google Login, customer roles, affiliate dashboards, crypto dashboards and Owner/Admin access will be
            connected in the backend phase.
          </p>
        </div>

        <div class="account-actions">
          <button class="button button-gold" type="button" disabled>Continue With Google — Backend Next</button>
          <span>Customer • Affiliate • Crypto • Admin • Owner</span>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div>
        <strong>BoyKingTut.com</strong>
        <span>Financial Domination Quantum</span>
      </div>
      <nav aria-label="Footer">
        <a href="#crypto">Crypto Risk</a>
        <a href="#affiliate">Affiliate Terms</a>
        <a href="#egypt">Travel Notice</a>
        <a href="#faq">FAQ</a>
      </nav>
      <p>
        18+ only. Crypto and leveraged trading are high risk. Nothing on this site is financial, investment, legal or tax advice.
      </p>
    </footer>
  </div>
</BaseLayout>
