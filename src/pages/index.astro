---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteNav from "../components/SiteNav.astro";
import AgeGate from "../components/AgeGate.astro";
import JobPopup from "../components/JobPopup.astro";
---

<BaseLayout>
  <AgeGate />
  <JobPopup />

  <div id="top" class="page-shell">
    <SiteNav />

    <main>
      <section class="hero">
        <div class="hero-content">
          <p class="eyebrow">BOYKINGTUT.COM</p>
          <h1>Financial Domination <span>Quantum</span></h1>
          <p class="hero-copy">
            One platform for crypto systems, local business advertising, independent affiliate opportunities,
            articles, live updates, a public Second Life metaverse destination and educational Egypt travel information.
          </p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="#services">EXPLORE SERVICES</a>
            <a class="btn btn-ghost" href="#account">JOIN / LOGIN</a>
          </div>
          <p class="risk-line">18+ • High-risk crypto content • Not financial advice</p>
        </div>

        <aside class="hero-panel">
          <div>
            <small>BUILT-IN PAYMENTS</small>
            <strong>Solana</strong>
            <span>5-minute locked quote • on-chain verification</span>
          </div>
          <div>
            <small>COMMUNITY</small>
            <strong>Local First</strong>
            <span>Independent businesses • affiliates • progress tracking</span>
          </div>
          <div>
            <small>ACCESS</small>
            <strong>Desktop + Mobile</strong>
            <span>Responsive Astro experience on Cloudflare</span>
          </div>
        </aside>
      </section>

      <section id="services" class="section">
        <div class="section-head">
          <p class="eyebrow">EXPLORE</p>
          <h2>Choose your path</h2>
        </div>

        <div class="cards cards-3">
          <article id="crypto" class="card feature-card">
            <span class="icon">₿</span>
            <h3>Online Crypto System</h3>
            <p>Discord alerts and the Solo Leverage Alarm system for experienced high-risk leverage traders.</p>
            <ul>
              <li>Basic: $50/month</li>
              <li>Pro: $150/month</li>
              <li>Extra crypto pair: +$50 each</li>
            </ul>
            <a href="#crypto-details">View Crypto</a>
          </article>

          <article id="advertising" class="card feature-card">
            <span class="icon">⌖</span>
            <h3>Local Advertising</h3>
            <p>Traffic-focused campaigns for independent local businesses with transparent progress monitoring.</p>
            <ul>
              <li>Local targeting up to 15 miles</li>
              <li>Upgraded targeting up to 50 miles</li>
              <li>$399 upgraded package + brochure design</li>
            </ul>
            <a href="#business-flow">View Advertising</a>
          </article>

          <article id="affiliate" class="card feature-card">
            <span class="icon">♛</span>
            <h3>Affiliates / Make Money</h3>
            <p>Approach local independent businesses, share your affiliate brochure and earn qualifying recurring commissions.</p>
            <ul>
              <li>$0 signup fee</li>
              <li>$0 monthly affiliate fee</li>
              <li>$50–$100 qualifying recurring commission</li>
            </ul>
            <a href="#affiliate-flow">How to Begin</a>
          </article>
        </div>
      </section>

      <section id="crypto-details" class="section split">
        <div>
          <p class="eyebrow">CRYPTO</p>
          <h2>Solo Leverage Alarm Machine</h2>
          <p>
            Hardware alert system intended for experienced leverage traders. A leverage-capable exchange account
            and reliable always-on internet connection are required.
          </p>

          <div class="price-row">
            <div><small>Machine</small><strong>$300</strong></div>
            <div><small>Included pair</small><strong>BTC</strong></div>
            <div><small>Extra pair</small><strong>+$50</strong></div>
            <div><small>Maintenance</small><strong>$150–$300/mo</strong></div>
          </div>

          <p class="notice">
            Cable, fiber, Starlink, or reliable always-on 5G/Wi-Fi is recommended. Timing is critical; outages or
            disconnections can result in missed alerts. No alert guarantees profit.
          </p>
        </div>

        <div class="card terminal-card">
          <div class="status-row"><span>Machine</span><strong class="ok">ACTIVE</strong></div>
          <div class="status-row"><span>BTC Pair</span><strong>INCLUDED</strong></div>
          <div class="status-row"><span>SOL Pair</span><strong>+ $50</strong></div>
          <div class="status-row"><span>Discord</span><strong class="ok">CONNECTED</strong></div>
          <div class="status-row"><span>Payment</span><strong>SOLANA</strong></div>
          <button class="btn btn-primary full" type="button" disabled title="Checkout wiring comes in the payment phase">
            PAY WITH SOLANA — COMING NEXT
          </button>
        </div>
      </section>

      <section id="business-flow" class="section">
        <div class="section-head">
          <p class="eyebrow">LOCAL BUSINESS</p>
          <h2>Simple campaign setup</h2>
          <p>Best suited to owner-operated local businesses rather than large national chains.</p>
        </div>

        <div class="steps">
          <div><b>1</b><span>Ask the business for its menu, brochure, flyer, service list or current price sheet.</span></div>
          <div><b>2</b><span>Upload the current image and confirm business details and offers.</span></div>
          <div><b>3</b><span>U.S.: choose ZIP code + radius. International: choose city + country, with postal area where appropriate.</span></div>
          <div><b>4</b><span>Choose the advertising package that fits the business.</span></div>
          <div><b>5</b><span>Client pays with Solana. After on-chain verification, the campaign can activate.</span></div>
          <div><b>6</b><span>Client and affiliate monitor progress, notes and renewal status from their dashboards.</span></div>
        </div>

        <p class="notice">Campaign performance should be evaluated over time. Results vary by business, location, offer, competition, season and customer demand. No specific customer-growth result is guaranteed.</p>
      </section>

      <section id="affiliate-flow" class="section split">
        <div>
          <p class="eyebrow">AFFILIATE / MARKETING SPECIALIST</p>
          <h2>Help your community grow</h2>
          <p>Focus on independent restaurants, pizza shops, cafés, barbers, salons, local shops and other privately owned businesses where the person you meet can make marketing decisions.</p>
          <div class="steps compact">
            <div><b>1</b><span>Create your account.</span></div>
            <div><b>2</b><span>Receive your affiliate ID, referral link and printable brochure.</span></div>
            <div><b>3</b><span>Visit suitable independent local businesses.</span></div>
            <div><b>4</b><span>Client signs up under your code and selects a package.</span></div>
            <div><b>5</b><span>Client pays the service fee with SOL. You do not pay a monthly affiliate fee.</span></div>
            <div><b>6</b><span>Monitor qualifying clients and commissions in your dashboard.</span></div>
          </div>
        </div>

        <div class="card affiliate-card">
          <span class="badge">START FOR $0</span>
          <h3>No signup fee. No monthly affiliate fee.</h3>
          <p>Qualifying commission becomes eligible when a referred client becomes an active paying subscriber under the program terms.</p>
          <div class="metric-grid">
            <div><small>Signup</small><strong>$0</strong></div>
            <div><small>Monthly affiliate fee</small><strong>$0</strong></div>
            <div><small>Commission</small><strong>$50–$100</strong></div>
            <div><small>Payout</small><strong>SOL</strong></div>
          </div>
          <a class="btn btn-primary full" href="#account">JOIN AS AFFILIATE</a>
        </div>
      </section>

      <section class="section">
        <div class="section-head">
          <p class="eyebrow">SOLANA</p>
          <h2>How payment works</h2>
        </div>

        <div class="steps">
          <div><b>1</b><span>Choose a product, service or subscription.</span></div>
          <div><b>2</b><span>The server requests the live SOL/USD rate from CoinGecko.</span></div>
          <div><b>3</b><span>The exact SOL amount is locked for 5 minutes.</span></div>
          <div><b>4</b><span>Send SOL to the checkout address shown by the system.</span></div>
          <div><b>5</b><span>The backend verifies the finalized Solana transaction, recipient, amount and transaction uniqueness.</span></div>
          <div><b>6</b><span>After verification, the qualifying service/order status updates automatically.</span></div>
        </div>

        <p class="notice">The blockchain can verify transactions; it does not guarantee investments, profits, business results, or the conduct of third parties.</p>
      </section>

      <section class="section cards cards-2">
        <article id="reddit" class="card content-card">
          <p class="eyebrow">REDDIT ARTICLES</p>
          <h2>400+ Articles & Memoirs</h2>
          <p>Featured writings, memoirs and updates gathered into one archive and refreshed when material is available.</p>
          <a class="text-link" href="#account">Explore Articles →</a>
        </article>

        <article id="tiktok" class="card content-card">
          <p class="eyebrow">TIKTOK</p>
          <h2>Updates & Live Streams</h2>
          <p>Follow <strong>@19nobodyknows22</strong> for current short-form updates and live streams.</p>
          <a class="text-link" href="https://www.tiktok.com/@19nobodyknows22" target="_blank" rel="noopener noreferrer">Open TikTok →</a>
        </article>
      </section>


      <section id="metaverse" class="section split">
        <div>
          <p class="eyebrow">SECOND LIFE / METAVERSE</p>
          <h2>Enter the Boy King Tut Virtual World</h2>
          <p>
            Visit the public Boy King Tut experience inside Second Life. Explore the virtual environment,
            meet other visitors, follow future events and access the experience from desktop or supported mobile devices.
          </p>

          <div class="pill-list">
            <span>Public Access</span>
            <span>3D Virtual World</span>
            <span>Desktop</span>
            <span>Mobile Access</span>
            <span>Community</span>
          </div>

          <div class="hero-actions">
            <a
              class="btn btn-primary"
              href="https://maps.secondlife.com/secondlife/Wild%20Hollow/91/153/2451"
              target="_blank"
              rel="noopener noreferrer"
            >
              TELEPORT NOW
            </a>
            <a
              class="btn btn-ghost"
              href="https://go.secondlife.com/mobile"
              target="_blank"
              rel="noopener noreferrer"
            >
              MOBILE ACCESS
            </a>
          </div>
        </div>

        <div class="card metaverse-card">
          <p class="eyebrow">PUBLIC DESTINATION</p>
          <h3>Wild Hollow</h3>
          <div class="status-row"><span>Region</span><strong>Wild Hollow</strong></div>
          <div class="status-row"><span>Coordinates</span><strong>91 / 153 / 2451</strong></div>
          <div class="status-row"><span>Access</span><strong class="ok">OPEN TO PUBLIC</strong></div>
          <div class="status-row"><span>Platform</span><strong>Second Life</strong></div>
          <p class="fine">
            Second Life account, viewer/app availability and platform access are provided by Linden Lab / Second Life
            and may change independently of BoyKingTut.com.
          </p>
        </div>
      </section>

      <section id="egypt" class="section split">
        <div>
          <p class="eyebrow">EGYPT — INFORMATION & EDUCATION</p>
          <h2>Explore Ancient Egypt</h2>
          <p>Educational destination information covering the Grand Egyptian Museum, Giza, Abydos, Luxor, Saqqara, Dendera, Aswan, Abu Simbel and other destinations.</p>
          <div class="pill-list">
            <span>G.E.M.</span><span>Giza</span><span>Abydos</span><span>Luxor</span><span>Saqqara</span><span>Dendera</span><span>Aswan</span><span>Abu Simbel</span>
          </div>
        </div>
        <div class="card">
          <h3>Travel Notice</h3>
          <p>BoyKingTut.com is not a travel agency, tour operator, airline, hotel provider or transportation company.</p>
          <p>Travelers arrange their own flights. Any tours, hotels, transportation, guides or excursions must be arranged with independent third-party providers or local travel agents.</p>
          <p class="fine">Prices, availability and entry requirements may change. Always verify current information directly with the appropriate provider or attraction.</p>
        </div>
      </section>

      <section id="faq" class="section">
        <div class="section-head">
          <p class="eyebrow">FAQ</p>
          <h2>Common questions</h2>
        </div>

        <div class="faq">
          <details>
            <summary>How are Solana payments verified?</summary>
            <p>The production backend will verify the transaction on-chain, including success/finalization, recipient, expected amount and whether the transaction has already been used.</p>
          </details>
          <details>
            <summary>Why is the checkout quote only valid for 5 minutes?</summary>
            <p>SOL/USD can move quickly. A short quote window keeps the amount predictable. If it expires before payment, a new quote is generated.</p>
          </details>
          <details>
            <summary>Does it cost money to become an affiliate?</summary>
            <p>No signup fee and no monthly affiliate platform fee are planned. Qualifying commission depends on referred clients becoming and remaining eligible paying subscribers under the program terms.</p>
          </details>
          <details>
            <summary>Can affiliates print their own brochures?</summary>
            <p>Yes. The planned affiliate dashboard includes a personal referral code/link and printable promotional material.</p>
          </details>
          <details>
            <summary>Is advertising performance guaranteed?</summary>
            <p>No. Campaign results vary based on the business, location, offer, market, competition and other conditions.</p>
          </details>
        </div>
      </section>

      <section id="pricing" class="section">
        <div class="section-head">
          <p class="eyebrow">PRICING SNAPSHOT</p>
          <h2>Current planned pricing</h2>
        </div>
        <div class="cards cards-4 pricing">
          <article class="card"><small>CRYPTO BASIC</small><strong>$50</strong><span>/month</span></article>
          <article class="card"><small>CRYPTO PRO</small><strong>$150</strong><span>/month</span></article>
          <article class="card"><small>EXTRA PAIR</small><strong>$50</strong><span>each</span></article>
          <article class="card"><small>ADVERTISING UPGRADE</small><strong>$399</strong><span>/month</span></article>
        </div>
      </section>

      <section id="account" class="section account-cta">
        <p class="eyebrow">ACCOUNT</p>
        <h2>Google Login + role-based dashboards are next</h2>
        <p>The next build phase will connect Google OAuth, customer/affiliate roles, Admin/Owner access, Discord signup webhooks, Solana checkout verification and persistent database records.</p>
        <button class="btn btn-primary" type="button" disabled title="Google OAuth is wired in the next phase">CONTINUE WITH GOOGLE — NEXT PHASE</button>
      </section>
    </main>

    <footer>
      <strong>BoyKingTut.com</strong>
      <span>Financial Domination Quantum</span>
      <nav>
        <a href="#faq">FAQ</a>
        <a href="#crypto">Crypto Risk</a>
        <a href="#affiliate">Affiliate Terms</a>
        <a href="#egypt">Travel Notice</a>
      </nav>
      <p>18+ only. Crypto and leveraged trading are high risk. Nothing on this site is financial, investment, legal or tax advice.</p>
    </footer>
  </div>
</BaseLayout>
