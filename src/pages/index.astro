<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#070709" />
    <meta name="description" content="Boy King Tut is coming soon. Join the mailing list for launch updates, 33 Trading Cards, crypto services, the audio book, TikTok updates and Reddit articles." />
    <title>Boy King Tut — Coming Soon</title>
    <style>
      :root{--bg:#070709;--card:#111115;--gold:#f5ca4d;--gold2:#9b7226;--text:#f7f2e7;--muted:#aaa8ad;--line:rgba(245,202,77,.22);--green:#40d89c}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;min-height:100vh;background:radial-gradient(circle at 50% -15%,#352a12 0,#111014 30%,var(--bg) 62%);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.page{min-height:100vh;position:relative;overflow:hidden}.page:before,.page:after{content:"";position:absolute;left:50%;top:200px;width:560px;height:560px;border:1px solid rgba(245,202,77,.06);transform:translateX(-50%) rotate(45deg);pointer-events:none}.page:after{width:390px;height:390px;top:285px;border-color:rgba(245,202,77,.09)}.wrap{position:relative;z-index:1;width:min(1100px,calc(100% - 32px));margin:auto}.nav{height:72px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(255,255,255,.06)}.brand{font-size:.92rem;font-weight:900;letter-spacing:.14em}.brand span{color:var(--gold)}.badge{padding:7px 11px;border:1px solid var(--line);border-radius:999px;font-size:.68rem;font-weight:850;letter-spacing:.12em;color:var(--gold)}.hero{text-align:center;padding:100px 0 65px}.eyebrow{font-size:.72rem;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);font-weight:900}.hero h1{font-size:clamp(3.5rem,10vw,8rem);letter-spacing:-.065em;line-height:.8;margin:21px 0 27px}.hero h1 span{display:block;color:var(--gold);font-size:.49em;letter-spacing:.04em;margin-top:18px}.hero>p{max-width:680px;margin:0 auto 32px;color:#c4c1c2;font-size:clamp(1rem,2vw,1.16rem);line-height:1.7}.form{width:min(680px,100%);margin:0 auto;display:grid;grid-template-columns:1fr 1.25fr auto;gap:9px;padding:9px;background:rgba(17,17,21,.88);border:1px solid var(--line);border-radius:18px;box-shadow:0 26px 80px rgba(0,0,0,.42)}.form input{min-width:0;background:#08080b;color:white;border:1px solid rgba(255,255,255,.09);border-radius:11px;padding:15px 14px;outline:none;font:inherit}.form input:focus{border-color:var(--gold);box-shadow:0 0 0 3px rgba(245,202,77,.08)}.form button{border:0;border-radius:11px;background:var(--gold);color:#181308;font-weight:900;padding:15px 20px;cursor:pointer;white-space:nowrap}.form button:hover{filter:brightness(1.06)}.form button:disabled{opacity:.65;cursor:wait}.formnote{min-height:20px;color:#8f8c90;font-size:.75rem;margin:9px 0 0}.formnote.success{color:var(--green)}.formnote.error{color:#f0a8a8}.trust{display:flex;justify-content:center;gap:18px;flex-wrap:wrap;margin-top:21px;color:#77757a;font-size:.7rem;text-transform:uppercase;letter-spacing:.11em}.trust b{color:#bcb8b4}.coming{padding:55px 0 100px}.sectiontop{text-align:center;margin-bottom:27px}.sectiontop h2{font-size:clamp(2rem,5vw,3.35rem);letter-spacing:-.045em;margin:8px 0 10px}.sectiontop p{color:var(--muted);max-width:620px;margin:auto;line-height:1.7}.grid{display:grid;grid-template-columns:repeat(2,1fr);border:1px solid var(--line);border-radius:26px;overflow:hidden;background:rgba(9,9,12,.72);box-shadow:0 25px 80px rgba(0,0,0,.27)}.item{min-height:240px;padding:29px;background:linear-gradient(145deg,rgba(255,255,255,.045),rgba(255,255,255,.01));border:1px solid rgba(255,255,255,.04);position:relative}.number{font:800 .72rem ui-monospace,monospace;color:var(--gold);letter-spacing:.08em}.icon{font-size:1.7rem;color:var(--gold);margin:24px 0 16px}.item h3{font-size:1.65rem;line-height:1.1;margin:0 0 12px}.item p{color:var(--muted);line-height:1.65;margin:0;font-size:.91rem}.chips{margin-top:17px}.chips span{display:inline-block;border-radius:999px;background:rgba(245,202,77,.08);color:#d2b458;font-size:.65rem;font-weight:800;padding:5px 8px;margin:3px 2px}.footer{padding:27px 0 35px;border-top:1px solid rgba(255,255,255,.06);display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;color:#65646a;font-size:.72rem}.footer strong{color:#aaa7a4}@media(max-width:720px){.hero{padding:76px 0 52px}.hero h1{font-size:clamp(3.45rem,18vw,5.2rem)}.form{grid-template-columns:1fr}.form button{width:100%}.grid{grid-template-columns:1fr}.item{min-height:215px}.nav{height:64px}.badge{font-size:.59rem}.brand{font-size:.75rem}.coming{padding-top:40px}.trust{gap:9px 14px}}
    </style>
  </head>
  <body>
    <div class="page">
      <div class="wrap">
        <nav class="nav">
          <div class="brand">BOY <span>KING TUT</span></div>
          <div class="badge">BOYKINGTUT.COM</div>
        </nav>

        <main>
          <header class="hero">
            <div class="eyebrow">Something new is awakening</div>
            <h1>COMING<span>SOON</span></h1>
            <p>BoyKingTut.com is becoming a home for the complete 33 Trading Card collection, crypto services, the Boy King Tut audio book, and fresh TikTok + Reddit updates.</p>

            <form class="form" id="mailingListForm">
              <input id="name" name="name" type="text" autocomplete="name" placeholder="Your name" aria-label="Your name" required />
              <input id="email" name="email" type="email" autocomplete="email" placeholder="Your email address" aria-label="Your email address" required />
              <button type="submit">JOIN THE LIST →</button>
            </form>
            <div class="formnote" id="formNote" role="status">Join the mailing list for launch news and new Boy King Tut releases. No spam.</div>

            <div class="trust"><span><b>33</b> CARDS</span><span>◈ SOLANA</span><span>◉ AUDIO BOOK</span><span>● TIKTOK + REDDIT</span></div>
          </header>

          <section class="coming">
            <div class="sectiontop">
              <div class="eyebrow">What will be inside</div>
              <h2>Four sides of Boy King Tut.</h2>
              <p>Join now and you’ll know when each part of the site opens.</p>
            </div>

            <div class="grid">
              <article class="item">
                <div class="number">01 / 04</div><div class="icon">✦</div>
                <h3>33 Trading Cards</h3>
                <p>Explore all 33 Boy King Tut cards. Purchase individual cards or the complete collection with SOL and receive personal printable permission for purchased cards.</p>
                <div class="chips"><span>33-CARD COLLECTION</span><span>SOL PAYMENT</span><span>PRINTABLE</span></div>
              </article>
              <article class="item">
                <div class="number">02 / 04</div><div class="icon">◉</div>
                <h3>Discord Crypto + Money Management</h3>
                <p>Access information about the Discord crypto service, market-monitoring updates and responsible money-management tools built around planning and risk awareness.</p>
                <div class="chips"><span>DISCORD</span><span>MARKET UPDATES</span><span>MONEY MANAGEMENT</span></div>
              </article>
              <article class="item">
                <div class="number">03 / 04</div><div class="icon">◒</div>
                <h3>Boy King Tut Audio Book</h3>
                <p>Listen to the Boy King Tut experience chapter by chapter from your phone, tablet or computer, with new audio releases collected in one place.</p>
                <div class="chips"><span>AUDIO</span><span>CHAPTERS</span><span>NEW RELEASES</span></div>
              </article>
              <article class="item">
                <div class="number">04 / 04</div><div class="icon">◇</div>
                <h3>TikTok + Reddit Updates</h3>
                <p>Follow new Boy King Tut TikTok drops alongside longer Reddit-style articles, updates and archives without hunting across different pages.</p>
                <div class="chips"><span>TIKTOK</span><span>REDDIT ARTICLES</span><span>LIVE UPDATES</span></div>
              </article>
            </div>
          </section>
        </main>

        <footer class="footer">
          <span>© <span id="year"></span> <strong>BoyKingTut.com</strong></span>
          <span>REMEMBER WHO YOU ARE.</span>
        </footer>
      </div>
    </div>

    <script>
      // Set this to your mailing-list endpoint when it is ready (for example /api/join).
      const MAILING_LIST_ENDPOINT = "";
      const form = document.getElementById("mailingListForm");
      const note = document.getElementById("formNote");
      const button = form.querySelector("button");

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;

        if (!MAILING_LIST_ENDPOINT) {
          note.className = "formnote error";
          note.textContent = "Mailing-list signup is ready visually; connect the signup endpoint before launch so submissions are actually saved.";
          return;
        }

        button.disabled = true;
        note.className = "formnote";
        note.textContent = "Joining…";
        try {
          const data = Object.fromEntries(new FormData(form));
          const response = await fetch(MAILING_LIST_ENDPOINT, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data)
          });
          if (!response.ok) throw new Error("Signup failed");
          form.reset();
          note.className = "formnote success";
          note.textContent = "You're on the list. Welcome to Boy King Tut.";
        } catch {
          note.className = "formnote error";
          note.textContent = "Could not join right now. Please try again shortly.";
        } finally {
          button.disabled = false;
        }
      });

      document.getElementById("year").textContent = new Date().getFullYear();
    </script>
  </body>
</html>
