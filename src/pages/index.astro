---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import AgeGate from "../components/AgeGate.astro";
import { getCurrentUser } from "../lib/auth";

export const prerender = false;
const user = await getCurrentUser(Astro);
---

<BaseLayout
  title="BoyKingTut.com — Eternal Spark"
  description="Boy King Tut Eternal Spark: crypto systems, affiliates, local advertising, Second Life metaverse, Egypt information, Reddit articles and TikTok updates."
>
  <AgeGate />
  <Nav user={user} />

  <main class="home-shell">
    <section class="cinematic-hero">
      <img
        class="cinematic-hero-image"
        src="/images/hero-eternal-spark.jpg"
        alt="Boy King Tut Eternal Spark hero"
      />
      <div class="cinematic-overlay"></div>

      <div class="hero-branding">
        <div class="wing-mark" aria-hidden="true">𓂀</div>
        <p class="hero-eyebrow">BOY KING TUT</p>
        <h1>ETERNAL SPARK</h1>
        <p class="hero-quote">Knowledge • Freedom • Financial Power</p>
        <p class="hero-subline">Build Your Reality.</p>

        <div class="hero-buttons">
          <a class="gold-cta" href="#services">EXPLORE SERVICES</a>
          <a
            class="discord-cta"
            href="https://discord.gg/HA73BUfJ67"
            target="_blank"
            rel="noopener noreferrer"
          >
            JOIN DISCORD
            <small>Discord.gg/HA73BUfJ67</small>
          </a>
        </div>
      </div>

      <div class="hero-right-quote">
        <strong>“BE YOU.”</strong>
        <strong>BE ACTIVE.</strong>
        <strong>WORK SMART</strong>
        <strong>NOT HARD.</strong>
      </div>
    </section>

    <section class="quick-strip" aria-label="Main systems">
      <a href="#crypto"><span>↗</span><b>CRYPTO LEVERAGE ALARMS</b><small>100x Solo Machine</small></a>
      <a href="#affiliate"><span>♛</span><b>AFFILIATE / MAKE MONEY</b><small>Earn with Our System</small></a>
      <a href="#advertising"><span>⌂</span><b>LOCAL ADVERTISING</b><small>Promote & Get Seen</small></a>
      <a href="#metaverse"><span>◉</span><b>SECOND LIFE METAVERSE</b><small>Wild Hollow Experience</small></a>
      <a href="#egypt"><span>△</span><b>EGYPT & ANCIENT KNOWLEDGE</b><small>History, Travel, Disclosure</small></a>
      <a href="#knowledge"><span>▤</span><b>EDUCATIONAL HUB</b><small>Expand Your Reality</small></a>
    </section>

    <section id="services" class="big-card-grid">
      <article id="crypto" class="big-card">
        <img src="/images/card-crypto.jpg" alt="Crypto Services" />
        <div class="big-card-body">
          <p class="card-kicker">🚀 CRYPTO SERVICES</p>
          <h2>Live Signals · Tools · Community</h2>
          <ul>
            <li>100x Leverage Alerts</li>
            <li>Discord Automation</li>
            <li>Tools & Member Access</li>
          </ul>
          <a href="#solo">EXPLORE CRYPTO</a>
        </div>
      </article>

      <article id="affiliate" class="big-card">
        <img src="/images/card-affiliate.jpg" alt="Affiliate Make Money" />
        <div class="big-card-body">
          <p class="card-kicker">🚀 AFFILIATE / MAKE MONEY</p>
          <h2>Multiple Income Streams</h2>
          <ul>
            <li>Recurring Earnings</li>
            <li>Global System</li>
            <li>Marketing Support</li>
          </ul>
          <a href="/auth/google?role=affiliate">JOIN AFFILIATE</a>
        </div>
      </article>

      <article id="metaverse" class="big-card cyan-card">
        <img src="/images/card-metaverse.jpg" alt="Second Life Metaverse" />
        <div class="big-card-body">
          <p class="card-kicker cyan">🚀 METAVERSE</p>
          <h2>Second Life — Wild Hollow</h2>
          <ul>
            <li>Build, Trade, Explore</li>
            <li>Events & Community</li>
            <li>Live in the Game</li>
          </ul>
          <a
            href="https://maps.secondlife.com/secondlife/Wild%20Hollow/91/153/2451"
            target="_blank"
            rel="noopener noreferrer"
          >
            ENTER METAVERSE
          </a>
        </div>
      </article>

      <article id="egypt" class="big-card">
        <img src="/images/card-egypt.jpg" alt="Egypt and Travel" />
        <div class="big-card-body">
          <p class="card-kicker">✦ EGYPT & TRAVEL</p>
          <h2>Walk the Ancient Path</h2>
          <ul>
            <li>Sacred Sites</li>
            <li>History & Disclosure</li>
            <li>Pyramid Activation</li>
          </ul>
          <a href="#travelNotice">PLAN YOUR JOURNEY</a>
        </div>
      </article>

      <article id="knowledge" class="big-card">
        <img src="/images/card-knowledge.jpg" alt="Knowledge Hub" />
        <div class="big-card-body">
          <p class="card-kicker">▤ KNOWLEDGE HUB</p>
          <h2>Articles · Reddit · TikTok</h2>
          <ul>
            <li>Reality Research</li>
            <li>Hidden History</li>
            <li>Independent Mind</li>
          </ul>
          <a href="#reddit">READ & WATCH</a>
        </div>
      </article>
    </section>

    <section class="community-banner">
      <div class="community-left">
        <div class="discord-orb">☯</div>
        <div>
          <h2>JOIN THE BOY KING TUT COMMUNITY</h2>
          <p>Real People. Real Tools. Real Freedom.</p>
          <a
            href="https://discord.gg/HA73BUfJ67"
            target="_blank"
            rel="noopener noreferrer"
          >
            Discord.gg/HA73BUfJ67
          </a>
        </div>
      </div>

      <div class="community-actions">
        <span>◉ Live Updates</span>
        <span>↗ Trading Alerts</span>
        <span>♙ New Member Support</span>
        <span>♛ Community Events</span>
      </div>
    </section>

    <section class="why-strip">
      <h2>WHY CHOOSE BOY KING TUT</h2>
      <div>
        <article><b>$</b><span>SECURE PAYMENTS<small>Solana Blockchain</small></span></article>
        <article><b>◷</b><span>INSTANT ACCESS<small>After Verification</small></span></article>
        <article><b>☵</b><span>24/7 SUPPORT<small>Discord Community</small></span></article>
        <article><b>✪</b><span>TRUSTED SYSTEM<small>Results Driven</small></span></article>
        <article><b>▯</b><span>MOBILE FRIENDLY<small>Access Anywhere</small></span></article>
      </div>
    </section>

    <section id="solo" class="hidden-detail-section">
      <h2>Solo Leverage Alarm Machine</h2>
      <div class="detail-grid">
        <div><strong>$300</strong><small>Machine</small></div>
        <div><strong>BTC</strong><small>Included Pair</small></div>
        <div><strong>+$50</strong><small>Each Extra Pair</small></div>
        <div><strong>$150–$300</strong><small>Monthly Service</small></div>
      </div>
      <p>
        Requires a leverage-capable exchange account and reliable always-on internet.
        High-risk leverage trading can result in rapid or total financial loss.
      </p>
    </section>

    <section id="advertising" class="hidden-detail-section">
      <h2>Local Advertising</h2>
      <p>
        Focused on independent local businesses such as pizza shops, restaurants,
        cafés, barbers, salons, stores and other privately owned businesses.
      </p>
      <div class="detail-grid">
        <div><strong>15 mi</strong><small>Standard local targeting</small></div>
        <div><strong>50 mi</strong><small>Upgraded targeting</small></div>
        <div><strong>$399</strong><small>Upgraded monthly package</small></div>
        <div><strong>Included</strong><small>Brochure design where applicable</small></div>
      </div>
    </section>

    <section id="reddit" class="hidden-detail-section">
      <h2>Reddit Articles + 400+ Memoirs</h2>
      <p>Featured writings, memoirs, observations and updates, refreshed when available.</p>
    </section>

    <section id="tiktok" class="hidden-detail-section">
      <h2>TikTok Updates & Live Streams</h2>
      <p>Follow <b>@19nobodyknows22</b> for updates and live streams.</p>
      <a
        class="gold-inline"
        href="https://www.tiktok.com/@19nobodyknows22"
        target="_blank"
        rel="noopener noreferrer"
      >
        OPEN TIKTOK →
      </a>
    </section>

    <section id="travelNotice" class="hidden-detail-section">
      <h2>Egypt Travel Information</h2>
      <p>
        BoyKingTut.com is not a travel agency. Travelers arrange their own flights,
        and third-party/local travel providers handle hotels, transportation, tours,
        guides and other services. Prices and availability may change.
      </p>
    </section>

    <section class="account-panel">
      <div>
        <p class="section-label">ACCOUNT</p>
        <h2>{user ? `Welcome back, ${user.name || user.email}` : "Google Login + Dashboard Access"}</h2>
        <p>
          {user
            ? `Your ${user.role} account is active.`
            : "Sign in with Google to access customer, affiliate and dashboard features."}
        </p>
      </div>

      {user
        ? <a class="gold-cta" href="/dashboard">OPEN DASHBOARD</a>
        : <div class="account-buttons">
            <a class="gold-cta" href="/auth/google?role=customer">CONTINUE WITH GOOGLE</a>
            <a class="dark-cta" href="/auth/google?role=affiliate">JOIN AS AFFILIATE</a>
          </div>}
    </section>
  </main>

  <footer class="cinematic-footer">
    <div class="footer-logo">𓂀 <b>BOY KING TUT</b><small>ETERNAL SPARK</small></div>
    <p>“Knowledge is Power. Freedom is Wealth. Build Your Reality.”</p>
    <small>© 2026 BoyKingTut.com · 18+ only · Not financial advice.</small>
  </footer>
</BaseLayout>
