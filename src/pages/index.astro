---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import AgeGate from "../components/AgeGate.astro";
import { getCurrentUser } from "../lib/auth";
export const prerender = false;
const user = await getCurrentUser(Astro);
---
<BaseLayout>
<AgeGate/><Nav user={user}/>
<main>
<section class="hero-home">
  <img class="hero-bg" src="/images/hero-main.jpg" alt="Boy King Tut Eternal Spark cosmic Egypt visual" />
  <div class="hero-overlay"></div>
  <div class="hero-content"><p class="eyebrow">BOYKINGTUT.COM</p><h1>BOY KING TUT<span>ETERNAL SPARK</span></h1><p class="tagline">Knowledge • Freedom • Financial Power<br/><b>Build Your Reality.</b></p><div class="actions"><a class="btn gold" href="#services">EXPLORE SERVICES</a><a class="btn discord" href="https://discord.gg/HA73BUfJ67" target="_blank">JOIN DISCORD</a></div></div>
</section>
<section class="trustbar"><div><b>Secure Payments</b><span>Solana Blockchain</span></div><div><b>Instant Access</b><span>After Verification</span></div><div><b>Community</b><span>Discord Updates</span></div><div><b>Mobile Friendly</b><span>Access Anywhere</span></div></section>

<section id="services" class="section"><div class="section-title"><p class="eyebrow">POWERFUL SERVICES</p><h2>Choose your path</h2></div><div class="service-cards">
<article id="crypto"><img src="/images/crypto.jpg" alt="Crypto dashboard visual"/><div><p class="eyebrow">CRYPTO SERVICES</p><h3>Crypto + Solo Machine</h3><ul><li>Basic $50 / Pro $150 monthly</li><li>Solo machine $300</li><li>BTC included; extra pairs +$50 each</li><li>Maintenance $150–$300/month</li><li>Leverage exchange account required</li></ul><a class="card-btn" href="#cryptoDetail">EXPLORE CRYPTO</a></div></article>
<article id="affiliate"><img src="/images/affiliate.jpg" alt="Affiliate local business visual"/><div><p class="eyebrow">AFFILIATE / MAKE MONEY</p><h3>Help Local Business Grow</h3><ul><li>$0 signup fee</li><li>$0 monthly affiliate fee</li><li>$50–$100 qualifying recurring commissions</li><li>Printable brochure + affiliate code</li><li>Paid in SOL</li></ul><a class="card-btn" href="/auth/google?role=affiliate">JOIN AFFILIATE</a></div></article>
<article id="metaverse"><img src="/images/metaverse.jpg" alt="Second Life metaverse visual"/><div><p class="eyebrow">SECOND LIFE METAVERSE</p><h3>Wild Hollow</h3><ul><li>Open to the public</li><li>Desktop + mobile access</li><li>Wild Hollow 91 / 153 / 2451</li><li>Explore, meet and connect</li></ul><a class="card-btn cyan" href="https://maps.secondlife.com/secondlife/Wild%20Hollow/91/153/2451" target="_blank">TELEPORT NOW</a></div></article>
<article id="egypt"><img src="/images/egypt.jpg" alt="Egypt travel education visual"/><div><p class="eyebrow">EGYPT & TRAVEL</p><h3>Walk the Ancient Path</h3><ul><li>G.E.M. museum information</li><li>Giza, Abydos, Luxor and more</li><li>Information and education only</li><li>Third-party/local agents arrange services</li></ul><a class="card-btn" href="#egyptInfo">EXPLORE EGYPT</a></div></article>
<article id="reddit"><img src="/images/knowledge.jpg" alt="Knowledge and article archive visual"/><div><p class="eyebrow">KNOWLEDGE HUB</p><h3>Articles + Updates</h3><ul><li>400+ Reddit articles / memoirs</li><li>TikTok @19nobodyknows22</li><li>Latest updates and live streams</li><li>Independent educational content</li></ul><a class="card-btn" href="#tiktok">READ & WATCH</a></div></article>
</div></section>

<section id="advertising" class="section split"><div><p class="eyebrow">LOCAL ADVERTISING</p><h2>Bring traffic to independent local businesses</h2><p>Designed for owner-operated pizza shops, restaurants, cafés, barbers, salons, local stores and private service businesses—not large national chains where the local person cannot approve marketing.</p><div class="pillrow"><span>15-mile local targeting</span><span>50-mile upgraded targeting</span><span>$399 upgraded plan</span><span>Progress dashboard</span></div></div><div class="panel"><h3>Campaign Setup</h3><ol><li>Request menu, brochure, flyer or price list.</li><li>Upload a current image.</li><li>Choose U.S. ZIP + radius or international city + country.</li><li>Select the package with the business owner.</li><li>Client pays with SOL and payment is verified on-chain.</li><li>Monitor progress and notes from the dashboard.</li></ol><p class="fine">Advertising results vary and are not guaranteed.</p></div></section>

<section id="cryptoDetail" class="section split"><div class="panel"><p class="eyebrow">SOLO LEVERAGE ALARM</p><h2>$300 Machine</h2><div class="kpis"><div><small>Included Pair</small><b>BTC</b></div><div><small>Extra Pair</small><b>+$50</b></div><div><small>Monthly Service</small><b>$150–$300</b></div><div><small>Internet</small><b>Always On</b></div></div></div><div><h2>Timing is key in crypto.</h2><p>Requires a leverage-capable exchange account and a steady connection such as cable, fiber, Starlink or reliable always-on 5G/Wi-Fi. If the device or internet is offline, alerts can be missed. High risk of financial loss. Entertainment and informational purposes only; no profit is guaranteed.</p></div></section>

<section class="community"><div><p class="eyebrow">DISCORD COMMUNITY</p><h2>Join the Boy King Tut Community</h2><p>Community updates, crypto member access, affiliate onboarding, renewal reminders, new order notifications and system announcements.</p></div><a class="btn discord" href="https://discord.gg/HA73BUfJ67" target="_blank">JOIN DISCORD COMMUNITY</a></section>

<section id="tiktok" class="section two"><article class="panel"><p class="eyebrow">TIKTOK</p><h2>Updates & Live Streams</h2><p>Follow <b>@19nobodyknows22</b> for video updates and live streams.</p><a class="card-btn" href="https://www.tiktok.com/@19nobodyknows22" target="_blank">OPEN TIKTOK</a></article><article class="panel"><p class="eyebrow">SECOND LIFE</p><h2>Public Metaverse Access</h2><p>Wild Hollow — coordinates 91 / 153 / 2451. Desktop and supported mobile access.</p><a class="card-btn cyan" href="https://maps.secondlife.com/secondlife/Wild%20Hollow/91/153/2451" target="_blank">TELEPORT</a></article></section>

<section id="egyptInfo" class="section"><div class="section-title"><p class="eyebrow">EGYPT EDUCATIONAL TRAVEL</p><h2>Information, not a travel agency</h2><p>Grand Egyptian Museum, Giza, Abydos, Luxor, Saqqara, Dendera, Aswan, Abu Simbel and more. Travelers arrange their own flights. Hotels, transportation, guides and tours must be arranged with independent third-party providers or local travel agents. Prices and availability may change.</p></div></section>

<section id="faq" class="section"><div class="section-title"><p class="eyebrow">FAQ</p><h2>Common Questions</h2></div><div class="faq"><details><summary>How does Google Login work?</summary><p>Google redirects back to BoyKingTut.com, the server verifies the account, creates or updates the user in Cloudflare D1, then creates a secure server-side session.</p></details><details><summary>How will Solana payment work?</summary><p>The checkout will get a live SOL/USD quote, lock it for 5 minutes, and only activate service after the finalized blockchain transaction is verified.</p></details><details><summary>Does it cost to become an affiliate?</summary><p>No signup fee and no monthly affiliate platform fee. Qualifying commissions begin when eligible clients sign up and pay under your affiliate account.</p></details><details><summary>Is BoyKingTut.com financial advice?</summary><p>No. Crypto and leverage content is informational/entertainment only and can involve substantial or total financial loss.</p></details></div></section>

<section class="account-home"><div><p class="eyebrow">ACCOUNT</p><h2>{user ? `Welcome back, ${user.name || user.email}` : 'Google Login + Cloudflare Database'}</h2><p>{user ? `Your ${user.role} account is active.` : 'Sign in securely with Google. New customers and affiliates are saved to Cloudflare D1 and can trigger a private Discord webhook notification.'}</p></div>{user ? <a class="btn gold" href="/dashboard">OPEN DASHBOARD</a> : <div class="actions"><a class="btn gold" href="/auth/google?role=customer">CONTINUE WITH GOOGLE</a><a class="btn outline" href="/auth/google?role=affiliate">JOIN AS AFFILIATE</a></div>}</section>
</main>
<footer><div class="logo footer-logo"><span class="logo-mark">𓂀</span><span><b>BOY KING TUT</b><small>ETERNAL SPARK</small></span></div><p>Knowledge is Power. Freedom is Wealth. Build Your Reality.</p><div class="footer-links"><a href="https://discord.gg/HA73BUfJ67">Discord</a><a href="/#faq">FAQ</a><a href="/#egyptInfo">Travel Notice</a><a href="/#cryptoDetail">Risk Notice</a></div><small>© 2026 BoyKingTut.com · 18+ only · Not financial advice.</small></footer>
</BaseLayout>
