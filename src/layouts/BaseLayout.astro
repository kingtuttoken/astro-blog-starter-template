---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "BoyKingTut.com — Financial Domination Quantum",
  description = "Crypto systems, local business advertising, affiliate opportunities, articles, TikTok updates and Egypt travel information.",
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07090c" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
