---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "BoyKingTut.com — Eternal Spark",
  description =
    "Boy King Tut Eternal Spark: crypto systems, affiliates, local advertising, Second Life metaverse, Egypt information, Reddit articles and TikTok updates.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />

    <meta name="description" content={description} />
    <meta name="theme-color" content="#03080e" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>
